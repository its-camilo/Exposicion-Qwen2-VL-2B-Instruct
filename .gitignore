# GGUF muy pesado para GitHub (~2.2 GB): no versionar pesos ni caché HF
models/*.gguf
models/.cache/
*.gguf

# Ollama blobs locales (si alguien corre ollama dentro del repo)
.ollama/

# Python / HF caché
__pycache__/
.venv/
hf_cache/

# Logs locales
/tmp/ollama.log
ollama.log

# Modelfile.ft se genera solo en cada máquina (lleva ruta absoluta al GGUF)
Modelfile.ft

# ¡OJO! Los scripts SÍ se versionan (negaciones bajo *.gguf):
!scripts/*.sh
!Modelfile
!README_MODELO.md
